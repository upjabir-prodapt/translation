# Local .env — keys match `Settings` in src/config/constants.py.
#
# GCP Secret Manager: the API expects one JSON payload, not this dotenv file.
#   • Use secret-manager.example.json as the template (proper types: booleans, numbers, arrays).
#   • Copy it, edit values, then add a version, e.g.:
#       gcloud secrets versions add YOUR_SECRET_NAME --data-file=secret-manager.example.json
#   • Omit from the JSON anything you already pass on Cloud Run --set-env-vars:
#       IS_LOCAL, GOOGLE_CLOUD_PROJECT_ID, GOOGLE_CLOUD_LOCATION,
#       APP_CONFIG_SECRET_NAME, APP_CONFIG_SECRET_VERSION
#   • Do not put GOOGLE_APPLICATION_CREDENTIALS in Secret Manager; use Cloud Run / WIF ADC.

IS_LOCAL=true
GOOGLE_CLOUD_PROJECT_ID=cloud-practice-dev-2
GOOGLE_CLOUD_LOCATION=us-central1
APP_CONFIG_SECRET_NAME=
APP_CONFIG_SECRET_VERSION=latest

GCS_BUCKET_NAME=colt-ai-usecase
GCS_ASSETS_PREFIX=assets
GCS_TRANSLATION_PREFIX=translation
GCS_INPUT_FOLDER=input
GCS_OUTPUT_FOLDER=output

BIGQUERY_DATASET=translation_service
BIGQUERY_LOCATION=US

API_USE_BACKGROUND_PIPELINE=true

GEMINI_INPUT_COST_PER_1K=0.0
GEMINI_OUTPUT_COST_PER_1K=0.0
JUDGE_MODEL=gemini-2.5-flash
QUALITY_THRESHOLD=0.6
MAX_MODEL_ATTEMPTS=3
GEMINI_MODEL=gemini-2.5-flash

WATERMARK_VERSION=1.0
DOCLAYOUT_MODEL_FILENAME=doclayout_yolo_docstructbench_imgsz1024.onnx
TABLE_DETECTION_MODEL_FILENAME=ch_PP-OCRv4_det_infer.onnx
FONT_METADATA_FILENAME=font_metadata.json
CMAP_METADATA_FILENAME=cmap_metadata.json
FONTS_DIR=fonts
CMAP_DIR=cmap
MODELS_DIR=models
METADATA_DIR=metadata
TIKTOKEN_DIR=tiktoken
GLOSSARIES_DIR=glossaries
MODEL_SELECTION_FILENAME=model_selection.json

JOB_TTL_HOURS=720
MAX_CONCURRENT_JOBS=10
TEMP_JOBS_ROOT=jobs
GCS_GLOSSARIES_PREFIX=glossaries

API_TITLE=DocTranslator Translation API
API_VERSION=1.0.0
API_PREFIX=/api/v1
STARTUP_WARMUP_ENABLED=true
STARTUP_WARMUP_STRICT=false
STARTUP_BACKGROUND_WARMUP_ENABLED=true
STARTUP_PREFLIGHT_TIMEOUT_SECONDS=20
STARTUP_PREFETCH_GLOSSARIES=[]
MODEL_SELECTION_CACHE_TTL_SECONDS=300
GLOSSARY_CACHE_TTL_SECONDS=1800
WARMUP_SYNC_CONCURRENCY=8
WARMUP_SYNC_PHASE_PREFIXES=["metadata","models","cmap","fonts","glossaries"]

ALLOWED_HOSTS=["*"]
CORS_ORIGINS=["*"]

MAX_FILE_SIZE=5242880
ALLOWED_EXTENSIONS=[".pdf"]

LOG_LEVEL=INFO

DOWNLOAD_MAX_ATTEMPTS=3
DOWNLOAD_RETRY_MIN_SECONDS=2
DOWNLOAD_RETRY_MAX_SECONDS=10
DOWNLOAD_RETRY_MULTIPLIER=1
LANGUAGE_DETECTION_MAX_CHARS=10000
GOOGLE_DLP_MAX_CHARS_PER_REQUEST=300000

ASSETS_ROOT=./assets
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json
