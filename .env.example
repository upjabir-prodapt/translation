# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT_ID=cloud-practice-dev-2
GOOGLE_CLOUD_LOCATION=us-central1
GCS_BUCKET_NAME=colt-ai-usecase
GCS_ASSETS_PREFIX=translation_service/artifacts
FIRESTORE_COLLECTION=jobs
BIGQUERY_DATASET=translation_service
BIGQUERY_LOCATION=US

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_QPS=4

# Local Development Only (DO NOT use in production)
# Path to service account key for local testing
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json

# Cache Configuration
BABELDOC_CACHE_DIR=./assests

# BabelDOC Asset Configuration
WATERMARK_VERSION=1.0
DOCLAYOUT_MODEL_FILENAME=doclayout_yolo_docstructbench_imgsz1024.onnx
TABLE_DETECTION_MODEL_FILENAME=ch_PP-OCRv4_det_infer.onnx
FONT_METADATA_FILENAME=font_metadata.json
CMAP_METADATA_FILENAME=cmap_metadata.json

# Cloud Tasks Configuration
CLOUD_TASKS_QUEUE=translation-queue
CLOUD_TASKS_LOCATION=us-central1
CLOUD_TASKS_DEADLINE_SECONDS=3600

# Job Configuration
JOB_TTL_HOURS=720

# Logging Configuration
LOG_LEVEL=INFO
