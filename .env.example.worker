# =============================================================================
# Worker Cloud Run secret template
# Secret Manager name (example): translation-worker-env
# Mounted at: /secrets/.env on the worker service
#
# Upload: gcloud secrets versions add translation-worker-env --data-file=.env.worker
# ASSETS_ROOT is normally overridden by Cloud Run --set-env-vars to the FUSE mount
# =============================================================================

# --- Runtime ---
IS_LOCAL=false
APP_ROLE=worker

# --- Google Cloud ---
GOOGLE_CLOUD_PROJECT=aicoesandox
GOOGLE_CLOUD_LOCATION=europe-west1

# --- Role ---
# Worker never runs in-process API background jobs
API_USE_BACKGROUND_PIPELINE=false
API_TITLE=DocTranslator Translation Worker
API_VERSION=1.0.0
APP_VERSION=0.5.23
API_PREFIX=/api/v1

# --- Cloud Tasks / OIDC (worker verifies inbound Tasks tokens) ---
CLOUD_TASKS_PROJECT=
CLOUD_TASKS_LOCATION=europe-west1
CLOUD_TASKS_QUEUE=translation-jobs
# Audience for OIDC verify — usually same as Tasks target URL (set via deploy env)
CLOUD_TASKS_WORKER_URL=https://translation-worker-xxxxx.run.app/internal/tasks/translate
CLOUD_TASKS_OIDC_SERVICE_ACCOUNT=translation-tasks@PROJECT.iam.gserviceaccount.com
# Cloud Tasks caps HTTP-target dispatch deadlines at 1800s (30 min).
CLOUD_TASKS_DISPATCH_DEADLINE_SECONDS=1800
WORKER_OIDC_AUDIENCE=
WORKER_SKIP_OIDC_VERIFICATION=false

# --- Security ---
# JWT still required by shared Settings when IS_LOCAL=false; not used for user auth on worker
ALLOWED_HOSTS=["*"]
CORS_ORIGINS=[]
JWT_SECRET_KEY=worker-unused-but-required-placeholder
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
# Absolute session cap for POST /auth/refresh (default 10080 = 7 days)
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080
# IAP not required when APP_ROLE=worker
IAP_AUDIENCE=
HUB_IAP_AUDIENCE=

# --- GCS / BigQuery (REQUIRED — download input, upload output, job status) ---
GCS_BUCKET_NAME=aicoesandox-vxai-translation-app-001
GCS_ASSETS_PREFIX=assets
GCS_TRANSLATION_PREFIX=translation-service
GCS_INPUT_FOLDER=input
GCS_OUTPUT_FOLDER=output
GCS_GLOSSARIES_PREFIX=glossaries
BIGQUERY_DATASET=aicoesandox_translation_dataset
BIGQUERY_LOCATION=europe-west1
BIGQUERY_TABLE=translation_jobs
BIGQUERY_COST_TABLE=translation_costs
BIGQUERY_DLP_TABLE=dlp_mappings
BIGQUERY_REVIEWS_TABLE=translation_reviews

# --- Startup & asset warmup (REQUIRED on worker + FUSE) ---
STARTUP_WARMUP_ENABLED=true
STARTUP_WARMUP_STRICT=false
STARTUP_BACKGROUND_WARMUP_ENABLED=true
STARTUP_PREFLIGHT_TIMEOUT_SECONDS=20
STARTUP_PREFETCH_GLOSSARIES=[]
MODEL_SELECTION_CACHE_TTL_SECONDS=300
GLOSSARY_CACHE_TTL_SECONDS=1800
WARMUP_SYNC_CONCURRENCY=8
WARMUP_SYNC_PHASE_PREFIXES=["metadata","models","cmap","fonts","glossaries"]

# --- LLM — models & quality routing (REQUIRED on worker) ---
QUALITY_JUDGE_ENABLED=true
JUDGE_MODEL=gemini-2.5-flash
JUDGE_MODEL_REGION=europe-west1
QUALITY_THRESHOLD=0.6
QUALITY_EARLY_ACCEPT_THRESHOLD=0.92
# Chunked judging: source-char budget per judged chunk, cap on chunks sent
# (a seeded stratified sample is taken above the cap), and a wall-clock
# safety net for the whole judging pass.
QUALITY_JUDGE_CHUNK_CHARS=8000
QUALITY_JUDGE_MAX_CHUNKS=16
QUALITY_JUDGE_TOTAL_BUDGET_SECONDS=420
QUALITY_JUDGE_MIN_COVERAGE_RATIO=0.5
MAX_MODEL_ATTEMPTS=3

# --- Input consistency guards (declared source language / domain) ---
# Two pre-translation guards that fail a job when the document contradicts
# what was declared. Both are fail-closed: a guard that cannot reach a verdict
# fails the job. A failed job is terminal and Cloud Tasks does not redeliver
# it, so a Vertex/DLP outage fails jobs permanently -- these two flags are the
# kill switches for that and must stay settable without a redeploy.
#
# ROLLOUT: ship both false, then enable one at a time.
#   Language: logs the full detected distribution even when disabled, so a
#     shadow run costs nothing -- read the logs, tune the threshold below,
#     then switch it on.
#   Domain: disabled means the LLM call is never made (no cost, no logs). To
#     shadow it, enable it and set DOMAIN_CLASSIFIER_MIN_CONFIDENCE above 1.0:
#     every document is classified and logged, but nothing can ever exceed the
#     floor, so no job fails.
LANGUAGE_MISMATCH_CHECK_ENABLED=false
DOMAIN_MISMATCH_CHECK_ENABLED=false
# Max share of detected characters any non-dominant language may hold before
# the document is rejected as mixed-language. 0.0 = strict (any second
# detected language fails), which is the intended policy: mixed-language
# translation is out of scope. Detection is per text block, so if monolingual
# documents are being rejected, raise this to absorb that noise (e.g. 0.10).
LANGUAGE_MIXED_MAX_SECONDARY_SHARE=0.0
# Empty falls back to JUDGE_MODEL / JUDGE_MODEL_REGION. Keeping the default
# means no new pricing_catalog.json entry is needed; a different model needs
# one or its cost cannot be resolved.
DOMAIN_CLASSIFIER_MODEL=
DOMAIN_CLASSIFIER_REGION=
# Only a contradiction at or above this confidence fails the job; below it the
# disagreement is logged and allowed. Business domains genuinely overlap, so
# this floor -- not the on/off flag -- is the real false-positive control.
DOMAIN_CLASSIFIER_MIN_CONFIDENCE=0.70
DOMAIN_CLASSIFIER_SAMPLE_CHARS=4000
DOMAIN_CLASSIFIER_TIMEOUT_SECONDS=60

GEMINI_MODEL=gemini-3.5-flash
GEMINI_MODEL_REGION=europe-west3
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_VERTEX_REGION=europe-west1

# --- LLM — performance & batching ---
TRANSLATION_POOL_MAX_WORKERS=12
TRANSLATION_MAX_QPS=16
TERM_EXTRACTION_POOL_MAX_WORKERS=12
SPLIT_PART_MAX_CONCURRENT=2
TYPESETTING_MAX_WORKERS=4
LLM_TRANSLATION_BATCH_MAX_TOKENS=1200
LLM_TRANSLATION_BATCH_MAX_PARAGRAPHS=60
LLM_TERM_EXTRACTION_BATCH_MAX_TOKENS=2000
LLM_TERM_EXTRACTION_BATCH_MAX_PARAGRAPHS=100
LLM_TOKEN_MULTIPLIER_CJK=0.5
LLM_TOKEN_MULTIPLIER_DEFAULT=1.0
LLM_MAX_CONTEXT_LENGTH=1000000
LLM_MAX_OUTPUT_TOKENS=8192
LLM_TEMPERATURE=0.0
LLM_TRANSLATION_MIN_TEXT_LENGTH=5
LLM_DISABLE_SAME_TEXT_FALLBACK=false
LLM_RETRY_MAX_ATTEMPTS=3
LLM_RETRY_MIN_SECONDS=1
LLM_RETRY_MAX_SECONDS=8
LLM_RETRY_MULTIPLIER=1

# --- ONNX / layout ---
ONNX_LAYOUT_BATCH_SIZE=4
ONNX_INTRA_OP_NUM_THREADS=4
ONNX_INTER_OP_NUM_THREADS=1

# --- DocTranslator assets ---
WATERMARK_VERSION=1.0
DOCLAYOUT_MODEL_FILENAME=doclayout_yolo_docstructbench_imgsz1024.onnx
TABLE_DETECTION_MODEL_FILENAME=ch_PP-OCRv4_det_infer.onnx
FONT_METADATA_FILENAME=font_metadata.json
CMAP_METADATA_FILENAME=cmap_metadata.json
FONTS_DIR=fonts
CMAP_DIR=cmap
MODELS_DIR=models
METADATA_DIR=metadata
TIKTOKEN_DIR=tiktoken
GLOSSARIES_DIR=glossaries
MODEL_SELECTION_FILENAME=model_selection.json
PRICING_CATALOG_FILENAME=pricing_catalog.json

# --- Job execution ---
JOB_TTL_HOURS=720
MAX_CONCURRENT_JOBS=10
TEMP_JOBS_ROOT=jobs
MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=[".pdf",".docx",".txt"]

# --- Logging / tracing ---
LOG_LEVEL=INFO
TRACE_ENABLED=true
TRACE_SAMPLE_RATE=1.0
OTEL_SERVICE_NAME=translation-worker
OTEL_EXPORTER_OTLP_ENDPOINT=https://telemetry.googleapis.com/v1/traces
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_RESOURCE_ATTRIBUTES=service.name=translation-worker,gcp.project_id=aicoesandox,deployment.environment=cloud
OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=SPAN_AND_EVENT
OTEL_PYTHON_LOGGING_AUTO_INSTRUMENTATION_ENABLED=false

# --- Retry — GCS & downloads ---
DOWNLOAD_MAX_ATTEMPTS=3
DOWNLOAD_RETRY_MIN_SECONDS=2
DOWNLOAD_RETRY_MAX_SECONDS=10
DOWNLOAD_RETRY_MULTIPLIER=1
GCS_RETRY_MAX_ATTEMPTS=5
GCS_RETRY_MIN_SECONDS=10
GCS_RETRY_MAX_SECONDS=300
GCS_RETRY_MULTIPLIER=2

# --- Language detection / DLP ---
LANGUAGE_DETECTION_MAX_CHARS=10000
# Language detection tuning (see src/worker/services/language_detection_core.py).
# Layer 1 -- ignore text where langdetect is unreliable: a unit must be this
# long, have this many words, and not be a run of proper nouns.
LANGUAGE_DETECTION_MIN_UNIT_CHARS=50
LANGUAGE_DETECTION_MIN_UNIT_WORDS=8
# Layer 2 -- mixed-language decision. Languages below NOISE_SHARE of detected
# characters are treated as incidental; the top language must hold at least
# MIN_DOMINANT_SHARE of the rest or the document is rejected as mixed. Below
# MIN_MIXED_DECISION_CHARS there is too little text to make that call.
LANGUAGE_DETECTION_NOISE_SHARE=0.05
LANGUAGE_DETECTION_MIN_DOMINANT_SHARE=0.70
LANGUAGE_DETECTION_MIN_MIXED_DECISION_CHARS=500
GOOGLE_DLP_ENABLED=true
GOOGLE_DLP_MIN_LIKELIHOOD=UNLIKELY
GOOGLE_DLP_MAX_CHARS_PER_REQUEST=300000

# --- Runtime paths (ASSETS_ROOT overridden by FUSE mount in CI) ---
ASSETS_ROOT=/mnt/assets-cache
# /tmp is a RAM-backed tmpfs on Cloud Run and every pipeline working file
# counts against the container memory limit. /workspace/tmp is created in
# Dockerfile.worker and is disk-backed under --execution-environment=gen2.
TEMP_DIR=/workspace/tmp
