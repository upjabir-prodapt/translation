# Environment files with secrets
.env
.env.local
.env.*.local
# Local reference copies of the production Secret Manager payloads
# (translation-service-env / translation-worker-env). These carry
# JWT_SECRET_KEY, REDIS_PASSWORD and IAP audiences -- never commit them.
.env.*.prod

